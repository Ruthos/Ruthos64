<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Ruthos: third-party licences</title>
<style>
body { font: 15px/1.5 system-ui, sans-serif; max-width: 58em; margin: 2em auto; padding: 0 1em; color: #222; }
pre { white-space: pre-wrap; background: #f4f4f6; padding: 1em; font-size: 13px; }
h2 { margin-top: 2em; border-top: 1px solid #ccc; padding-top: 1em; }
ul { columns: 2; font-size: 13px; }
@media (prefers-color-scheme: dark) { body { background: #1c1c1e; color: #e8e8e8; } pre { background: #2a2a2d; } }
</style>
</head>
<body>
<h1>Ruthos: third-party licences</h1>
<!-- PREFACE -->
<h2>Rust crates</h2>
{{#each licenses}}
<h3>{{name}}</h3>
<p>Used by:</p>
<ul>{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>{{/each}}</ul>
<pre>{{text}}</pre>
{{/each}}
<!-- BUNDLED -->
</body>
</html>
